[Unit]
Description=Turntable to Sonos
After=network-online.target icecast2.service sound.target
Wants=network-online.target icecast2.service

[Service]
User=pi
EnvironmentFile=/etc/turntable.env
ExecStart=/home/pi/turntable-venv/bin/python /home/pi/turntable/server.py
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
