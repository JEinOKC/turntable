[Unit]
Description=Turntable control app (Sonos, page, recognition)
After=network-online.target turntable-audio.service
Wants=network-online.target turntable-audio.service

[Service]
User=pi
EnvironmentFile=/etc/turntable.env
ExecStart=/home/pi/turntable-venv/bin/python /home/pi/turntable/server.py
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=3
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
